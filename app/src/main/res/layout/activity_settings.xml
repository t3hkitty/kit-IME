<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kawaii_gold"
    android:padding="16dp">

    <!-- Header Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_ime_panel"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_kitime_logo"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kit-IME Preferences 🐾"
                android:textColor="@color/kawaii_lavender"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OnePlus 11 5G • Kawaiian Engine v3.1"
                android:textColor="@color/kawaii_pink"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Switches Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/kawaii_card_bg"
        android:padding="12dp">

        <!-- Spacebar + Number Chords Switch -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_space_chord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_chord_mode"
            android:textColor="@color/kawaii_slate"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_chord_mode_summary"
            android:textColor="#555"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- 2-Letter Greenlighting Switch -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_greenlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_greenlight"
            android:textColor="@color/kawaii_slate"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_greenlight_summary"
            android:textColor="#555"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- Soft Bzzt Haptic Switch -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_soft_bzzt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_soft_bzzt"
            android:textColor="@color/kawaii_slate"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_soft_bzzt_summary"
            android:textColor="#555"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- Pre-Send Guard Switch -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_send_guard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_send_guard"
            android:textColor="@color/kawaii_slate"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_send_guard_summary"
            android:textColor="#555"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
