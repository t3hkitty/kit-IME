<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kawaii_gold"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_ime_panel"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_kitime_logo"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kit-IME Control Hub 🐾"
                    android:textColor="@color/kawaii_lavender"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OnePlus 11 5G • Kawaiian Engine v3.1-Plump"
                    android:textColor="@color/kawaii_pink"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 1. System IME Setup & Picker Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/kawaii_card_bg"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. System Keyboard Activation ⚙️"
                android:textColor="@color/kawaii_slate"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Live Status Badges -->
            <TextView
                android:id="@+id/txt_ime_enabled_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏳ [IME Enabled: Checking...]"
                android:textColor="@color/kawaii_indigo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/txt_ime_selected_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏳ [IME Selected: Checking...]"
                android:textColor="@color/kawaii_indigo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Action 1: Open System Input Settings -->
            <Button
                android:id="@+id/btn_open_ime_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_open_ime_settings"
                android:textColor="@color/kawaii_gold"
                android:backgroundTint="@color/kawaii_indigo"
                android:layout_marginBottom="8dp" />

            <!-- Action 2: Choose Active Keyboard -->
            <Button
                android:id="@+id/btn_choose_active_ime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_choose_active_ime"
                android:textColor="@color/kawaii_slate"
                android:backgroundTint="@color/kawaii_lavender" />
        </LinearLayout>

        <!-- 2. Typing, Ribbon, Haptics & Send Guard Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/kawaii_card_bg"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Typing Engine &amp; Feedback Controls 🌸"
                android:textColor="@color/kawaii_slate"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Tri-Split Ribbon Visibility Switch -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_ribbon_visibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_ribbon_visibility"
                android:textColor="@color/kawaii_slate"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_ribbon_visibility_summary"
                android:textColor="#555"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <!-- Theme Palette Selection Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_theme_selection"
                android:textColor="@color/kawaii_slate"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_theme"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_ime_panel"
                android:padding="8dp"
                android:layout_marginBottom="12dp" />

            <!-- Spacebar + Number Chords Switch -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_space_chord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_chord_mode"
                android:textColor="@color/kawaii_slate"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_chord_mode_summary"
                android:textColor="#555"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <!-- 2-Letter Greenlighting Switch -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_greenlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_greenlight"
                android:textColor="@color/kawaii_slate"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_greenlight_summary"
                android:textColor="#555"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <!-- Soft Bzzt Haptic Switch -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_soft_bzzt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_soft_bzzt"
                android:textColor="@color/kawaii_slate"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_soft_bzzt_summary"
                android:textColor="#555"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <!-- Pre-Send Guard Switch -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_send_guard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_send_guard"
                android:textColor="@color/kawaii_slate"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_send_guard_summary"
                android:textColor="#555"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <!-- Zero Post-Commit Rewriting Lock Card Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_candidate_greenlit"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Zero Post-Commit Rewriting: ACTIVE"
                    android:textColor="@color/kawaii_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kit-IME never retroactively rewrites, autocorrects, or flips committed words (e.g., 'its' vs 'it\'s', plurals, or exact verbatim user phrasing are 100% preserved)."
                    android:textColor="@color/kawaii_gold"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- 3. Cast Slots & TextExpander Quick Editor Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/kawaii_card_bg"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Cast Slots &amp; TextExpander ⚡"
                android:textColor="@color/kawaii_slate"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quick variables &amp; snippet expansions ({{clip}}, {{date}}, {{time}}, {{name}}, {{email}})."
                android:textColor="#555"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <!-- Cast Slots Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/edit_char1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="&lt;char1&gt;"
                    android:textSize="12sp"
                    android:textColor="@color/kawaii_slate"
                    android:background="@drawable/bg_ime_panel"
                    android:padding="8dp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/edit_char2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:hint="&lt;char2&gt;"
                    android:textSize="12sp"
                    android:textColor="@color/kawaii_slate"
                    android:background="@drawable/bg_ime_panel"
                    android:padding="8dp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/edit_loc1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:hint="&lt;loc1&gt;"
                    android:textSize="12sp"
                    android:textColor="@color/kawaii_slate"
                    android:background="@drawable/bg_ime_panel"
                    android:padding="8dp"
                    android:singleLine="true" />
            </LinearLayout>

            <EditText
                android:id="@+id/edit_snippets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint=";date={{date}}&#10;;clip={{clip}}&#10;;sig=Best, {{name}}"
                android:textSize="12sp"
                android:textColor="@color/kawaii_slate"
                android:textColorHint="#888"
                android:background="@drawable/bg_ime_panel"
                android:padding="8dp"
                android:minLines="3"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_save_expander"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Slots &amp; Expander Snippets 💾"
                android:textColor="@color/kawaii_gold"
                android:backgroundTint="@color/kawaii_indigo" />
        </LinearLayout>

        <!-- 4. Predictor, Corpus & Firebase Sync Hub Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/kawaii_card_bg"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Predictor, Corpus &amp; Firebase Sync 🐾"
                android:textColor="@color/kawaii_slate"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txt_sync_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ [status: ready] WAL active • Zero Post-Commit Rewriting"
                android:textColor="@color/kawaii_indigo"
                android:textSize="12sp"
                android:padding="4dp"
                android:layout_marginBottom="12dp" />

            <!-- Remote Google Docs Input Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_google_docs_title"
                android:textColor="@color/kawaii_slate"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edit_google_doc_urls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_google_docs_urls"
                android:textSize="12sp"
                android:textColor="@color/kawaii_slate"
                android:textColorHint="#888"
                android:background="@drawable/bg_ime_panel"
                android:padding="8dp"
                android:minLines="2"
                android:gravity="top|start"
                android:inputType="textMultiLine|textUri"
                android:layout_marginBottom="6dp" />

            <!-- Apps Script Auth Token -->
            <EditText
                android:id="@+id/edit_apps_script_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_apps_script_token"
                android:textSize="12sp"
                android:textColor="@color/kawaii_slate"
                android:textColorHint="#888"
                android:background="@drawable/bg_ime_panel"
                android:padding="8dp"
                android:singleLine="true"
                android:layout_marginBottom="8dp" />

            <!-- Button: Sync Google Docs Corpus Now -->
            <Button
                android:id="@+id/btn_sync_google_docs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_sync_google_docs"
                android:textColor="@color/kawaii_gold"
                android:backgroundTint="@color/kawaii_pink"
                android:layout_marginBottom="8dp" />

            <!-- Gather Local (SMS / SAF / Share) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_run_gather_now"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gather Local 🐾"
                    android:textColor="@color/kawaii_gold"
                    android:backgroundTint="@color/kawaii_indigo" />

                <Button
                    android:id="@+id/btn_pick_saf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Pick SAF Folder"
                    android:textColor="@color/kawaii_slate"
                    android:backgroundTint="@color/kawaii_lavender" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_grant_sms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grant SMS 📱"
                    android:textColor="@color/kawaii_gold"
                    android:backgroundTint="@color/kawaii_indigo" />

                <Button
                    android:id="@+id/btn_import_file"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Import File 📄"
                    android:textColor="@color/kawaii_slate"
                    android:backgroundTint="@color/kawaii_lavender" />
            </LinearLayout>

            <!-- Flush Firebase Deltas Card Button with Pending Count & Timestamp -->
            <Button
                android:id="@+id/btn_flush_firebase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Flush Firebase Deltas (0 pending) 🔥"
                android:textColor="@color/kawaii_indigo"
                android:backgroundTint="@color/kawaii_lavender"
                android:layout_marginBottom="8dp" />

            <!-- Sync UserDictionary -->
            <Button
                android:id="@+id/btn_sync_user_dict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_sync_user_dict"
                android:textColor="@color/kawaii_indigo"
                android:backgroundTint="@color/kawaii_lavender"
                android:layout_marginBottom="8dp" />

            <!-- Import Keep Notes Vault Action Button (Gated on SAF Vault) -->
            <Button
                android:id="@+id/btn_import_keep_vault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_import_keep_vault"
                android:textColor="@color/kawaii_gold"
                android:backgroundTint="@color/kawaii_indigo"
                android:layout_marginBottom="8dp" />

            <!-- Snapshot DB & Restore (VACUUM INTO pre-sync + restore picker) -->
            <Button
                android:id="@+id/btn_restore_snapshot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Snapshot DB &amp; Restore 📦"
                android:textColor="@color/kawaii_gold"
                android:backgroundTint="@color/kawaii_pink" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
