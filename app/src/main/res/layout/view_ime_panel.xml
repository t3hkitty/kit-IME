<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_ime_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_ime_panel"
    android:visibility="visible"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Double-Check Before Send Bar -->
    <LinearLayout
        android:id="@+id/layout_send_guard_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:padding="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_candidate_greenlit">

        <TextView
            android:id="@+id/tv_send_guard_prompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✨ Ready to Send? Press Enter / Tap Confirm"
            android:textColor="@color/kawaii_gold"
            android:textStyle="bold"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_send_confirm"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Confirm 🐾"
            android:textSize="12sp"
            android:textColor="@color/kawaii_slate"
            android:backgroundTint="@color/kawaii_greenlight" />

        <Button
            android:id="@+id/btn_send_cancel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:text="Cancel ✕"
            android:textSize="12sp"
            android:textColor="@color/kawaii_lavender"
            android:backgroundTint="@color/kawaii_slot_bg" />
    </LinearLayout>

    <!-- Gboard-Style Quick Actions & Toolbar Bar -->
    <LinearLayout
        android:id="@+id/layout_quick_toolbar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:layout_marginBottom="2dp">

        <!-- Arrows Pad Toggle Button -->
        <Button
            android:id="@+id/btn_toolbar_arrows"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Arrows ⤹"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/kawaii_slate"
            android:backgroundTint="@color/kawaii_pink"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp" />

        <!-- Emoji Drawer Toggle Button -->
        <Button
            android:id="@+id/btn_toolbar_emoji"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="🌸 Emoji"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/kawaii_slate"
            android:backgroundTint="@color/kawaii_lavender"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp" />

        <!-- Clipboard Shelf Toggle Button -->
        <Button
            android:id="@+id/btn_toolbar_clipboard"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="📋 Shelf"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/kawaii_slate"
            android:backgroundTint="@color/kawaii_lavender"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_chord_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[Space+1..5]"
            android:textColor="@color/kawaii_pink"
            android:textStyle="bold"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Tri-Split Ribbon Shell -->
    <com.kitime.ime.ui.TriSplitRibbonView
        android:id="@+id/tri_split_ribbon"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:visibility="visible" />

    <!-- Full On-Screen Key Grid -->
    <com.kitime.ime.ui.SoftKeyGridView
        android:id="@+id/soft_key_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible" />

</LinearLayout>
